{
  "name": "csl-seqirus",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c red,gray \"vite\" \"npm:dev:api\"",
    "dev:api": "wrangler pages dev --port 8788 --live-reload=false",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "db:migrate:local": "wrangler d1 migrations apply csl-seqirus-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply csl-seqirus-db --remote",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.20.0"
  }
}
